{
  "name": "pm-server",
  "version": "1.1.0",
  "description": "Preeti Makeover Salon REST API Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "prisma generate && node scripts/migrate-deploy.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.js",
    "db:studio": "prisma studio",
    "db:ensure": "node scripts/ensure-db.js",
    "seed": "node scripts/ensure-db.js && node prisma/seed.js",
    "admin:setup": "node scripts/ensure-db.js && node scripts/setup-admin.js",
    "test": "node tests/api.test.js"
  },
  "keywords": [
    "preeti-makeover",
    "salon",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Webgent",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
