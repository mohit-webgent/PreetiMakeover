# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed Frontend Origin(s) for CORS. In production, set to your Vercel app domain (e.g. https://your-project.vercel.app)
# Supports single URL, comma-separated URLs, with or without trailing slash.
CLIENT_URL="http://localhost:5173"

# PostgreSQL Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:your_secure_password@localhost:5432/preeti_makeover?schema=public
DATABASE_URL="postgresql://postgres:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/preeti_makeover?schema=public"

# JWT Authentication Secret (MANDATORY IN PRODUCTION)
# Generate a strong 64-char key using: openssl rand -hex 32
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET_KEY_FOR_JWT_SIGNING"

# Initial Admin User Setup (Optional - for initial seed only)
INITIAL_ADMIN_EMAIL="admin@preetimakeover.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_INITIAL_PASSWORD"

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Business WhatsApp & Contact Details (Fallback if DB settings are not yet loaded)
SALON_PHONE="+918810359438"
SALON_WHATSAPP="+918810359438"
SALON_EMAIL="preetimakeoverpm@gmail.com"
