# ─────────────────────────────────────────────────────────────
# Preeti Makeover API — environment template (copy to .env)
# Never commit real secrets. Required in production are marked [REQUIRED].
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# Number of reverse proxies in front of the app (Render = 1). Defaults to 1 in production.
# TRUST_PROXY=1

# Allowed frontend origin(s) for CORS — comma-separated, trailing slashes OK.
CLIENT_URL="http://localhost:5173"

# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://postgres:REPLACE_WITH_YOUR_DB_PASSWORD@localhost:5432/preeti_makeover?schema=public"

# [REQUIRED in production] JWT signing secret, at least 32 chars. Generate: openssl rand -hex 32
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET_KEY_FOR_JWT_SIGNING"
JWT_EXPIRES_IN=24h

# Image uploads — set in production so photos persist across redeploys.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (Cloudinary dashboard → API Keys)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=preeti-makeover
UPLOAD_MAX_MB=8

# Initial admin (used by `npm run seed` only)
INITIAL_ADMIN_EMAIL="admin@preetimakeover.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_INITIAL_PASSWORD"

# General API rate limit per IP
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# Business fallbacks (used if DB settings are not yet loaded)
SALON_PHONE="+918810359438"
SALON_WHATSAPP="+918810359438"
SALON_EMAIL="preetimakeoverpm@gmail.com"

# Local Windows PostgreSQL auto-start (development only)
# PG_CTL="D:\Postgres\bin\pg_ctl.exe"
# PG_DATA="D:\Postgres\data"
